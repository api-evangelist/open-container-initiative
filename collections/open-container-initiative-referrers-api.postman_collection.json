          "id": "3677400d-339c-41e1-9576-85cb97cfb5df",
          "name": "List referrers for a manifest",
          "request": {
            "name": "List referrers for a manifest",
            "description": {
              "content": "Fetch the list of manifests that reference the supplied digest as their subject.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                ":name",
                "referrers",
                ":digest"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "artifactType",
                  "value": "<string>",
                  "description": "Filter referrers by artifact type."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "name",
                  "description": "(Required) The repository name (may contain slashes)."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "digest",
                  "description": "(Required) A content-addressable digest such as sha256:abcd..."
                },
                {
                  "description": "The hostname of the registry",
                  "type": "any",
                  "value": "{{registry}}",
                  "key": "registry"
                }
              ]
            },
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "8f1abc6d-90f3-4ee7-b7cf-d9056ef9d7c1",
              "name": "Index of referrers returned.",
